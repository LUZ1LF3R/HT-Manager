# .env.example — never commit real values
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Default is for host-side (non-Docker) runs; Compose overrides this internally
# to use the `postgres` service hostname.
DATABASE_URL=postgresql+asyncpg://ht_manager:ht_manager@localhost:5432/ht_manager
CTFTIME_TEAM_ID=
RESULTS_CHANNEL_ID=
CTF_FORUM_CHANNEL_ID=
ADMIN_ROLE_IDS=
MEMBER_ROLE_ID=
BOT_LOG_CHANNEL_ID=
CTF_RESOURCE_RETENTION_DAYS=60
PUBLIC_API_ORIGINS=https://hackertroupe.dev
LOG_LEVEL=INFO
