# .env.example — never commit real values
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Default is for host-side (non-Docker) runs; Compose overrides this
# internally to use the `postgres` service hostname, built from the
# POSTGRES_* values below so the credentials stay consistent.
DATABASE_URL=postgresql+asyncpg://ht_manager:ht_manager@localhost:5432/ht_manager
# Only used by Docker Compose, to configure the Postgres container and to
# build DATABASE_URL for the bot/migrate services. Change the password for
# any non-local deployment.
POSTGRES_USER=ht_manager
POSTGRES_PASSWORD=ht_manager
POSTGRES_DB=ht_manager
CTFTIME_TEAM_ID=
RESULTS_CHANNEL_ID=
CTF_CATEGORY_ID=
CTF_ARCHIVE_CATEGORY_ID=
ADMIN_ROLE_IDS=
MEMBER_ROLE_ID=
BOT_LOG_CHANNEL_ID=
CTF_RESOURCE_RETENTION_DAYS=60
LOG_LEVEL=INFO
